# ── Watch Party Stream Bot ──
# Token dari @BotFather
BOT_TOKEN=
# ID Telegram admin (boleh lebih dari satu, pisahkan koma). Cek ID lewat /id di bot.
ADMIN_IDS=
# Folder film (default: Download Android). Subfolder ikut dipindai.
MOVIE_DIR=~/storage/downloads
# Kecepatan encode saat transcode: ultrafast (ringan) … veryfast (default) … medium (bagus tapi berat)
X264_PRESET=veryfast
# Kedalaman subfolder yang dipindai
SCAN_DEPTH=4
